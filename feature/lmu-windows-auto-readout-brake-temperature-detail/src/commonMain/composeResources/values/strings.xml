<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="brake_temperature_description">ブレーキ温度が過熱した際に音声でお知らせします。一度警告を読み上げた後は、4輪すべてが閾値より約100℃低い温度まで下がるまで再度読み上げません。\n読み上げる文言は下の欄で設定できます。</string>
    <string name="brake_temperature_warning_title">過熱警告</string>
    <string name="brake_temperature_vehicle_class_target_subtitle">対象クラス</string>
    <string name="brake_temperature_threshold_subtitle">過熱閾値</string>
    <string name="brake_temperature_threshold_help_icon_content_description">過熱閾値の説明を表示</string>
    <string name="brake_temperature_threshold_help_description">選択した車両クラスで走行中に、4輪のうち1輪でも設定した温度以上になると過熱警告を読み上げます。ブレーキの適正温度はディスクの素材によって大きく異なり、LMPやハイパーカーのカーボンディスクは高温側、GT3などのスチールディスクは低温側が適正です。初期値は全クラス共通のため、走行後にデバッグ画面のブレーキ温度を確認しながらクラスごとに調整してください。</string>
    <string name="brake_temperature_threshold_description">いずれかのブレーキが%1$d℃以上になると警告を読み上げます。</string>
    <string name="brake_temperature_threshold_label">%1$s℃</string>
    <string name="brake_temperature_threshold_reset">デフォルトに戻す</string>
    <string name="brake_temperature_text_reset_to_default">デフォルトに戻す</string>
    <string name="brake_temperature_text_label">ブレーキ温度が閾値以上になったときの文言</string>
    <string name="brake_temperature_celsius_insert">{celsius}を挿入</string>
    <string name="brake_temperature_celsius_placeholder_hint">{celsius} は選択中の車両クラスの温度閾値(℃)に置き換わります</string>
    <string name="brake_temperature_text_supporting">空欄のままなら読み上げません</string>
    <string name="brake_temperature_text_unavailable">この端末では音声合成を利用できないため、読み上げません</string>
    <string name="brake_temperature_text_preview">入力した文言を再生</string>
    <string name="brake_temperature_text_selected_icon">この文言を読み上げます</string>
    <string name="brake_temperature_text_unknown_placeholders">%1$s は置き換えられません。{celsius} を使用してください</string>
</resources>
